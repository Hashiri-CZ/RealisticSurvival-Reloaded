<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>harshlands-spigot_impl_26_2_R1</artifactId>
    <packaging>jar</packaging>

    <parent>
        <groupId>cz.hashiri.harshlands</groupId>
        <artifactId>harshlands-parent</artifactId>
        <version>1.3.3</version>
    </parent>

    <dependencies>
        <!--
            Coordinate CONFIRMED against BuildTools output (2026-09-09): running
            BuildTools for rev 26.2 installs exactly org.spigotmc:spigot:26.2-R0.1-SNAPSHOT,
            matching the "<exact MC version>-R0.<n>-SNAPSHOT" shape used by the sibling
            modules (26.1.2-R0.1-SNAPSHOT, 1.21.11-R0.2-SNAPSHOT).

            Like MC 26.1 — and unlike 1.21.11 — the 26.2 artifact ships Mojang-mapped
            with no remapped-mojang classifier, so this module deliberately carries NO
            <classifier> and NO specialsource-maven-plugin remap executions. Verified by
            inspecting the installed artifact: the only jar present is the plain
            spigot-26.2-R0.1-SNAPSHOT.jar.

            Spigot jars are not published to any public Maven repository — every
            developer must install this locally with BuildTools (see README.md).
        -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot</artifactId>
            <version>26.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>cz.hashiri.harshlands</groupId>
            <artifactId>harshlands-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <!--
                        Mirrors spigot_impl_26_1_R1. The module compiles cleanly against
                        the real 26.2 artifact at this level. Do NOT lower it to make the
                        module build on an older JDK — that silently changes the bytecode
                        level that ships to users. Raising it is fine if a future 26.x
                        server requires a newer Java.
                    -->
                    <release>25</release>
                </configuration>
            </plugin>
            <!--
                Forks compilation onto a JDK 25+ toolchain. Version, executions and the
                auto-discovery settings are defined once in the parent pom's
                <pluginManagement> — see the comment there for the rationale and for what
                to do when the build reports that no matching JDK toolchain was found.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
